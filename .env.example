# DevAgent Environment Variables (optional — config.toml is the primary config)
# These are NOT used by DevAgent directly. They are here for reference only.

# LLM API Keys (only needed if using cloud providers)
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# GitHub Personal Access Token
GITHUB_PERSONAL_ACCESS_TOKEN=

# Brave Search API Key (optional)
BRAVE_API_KEY=

# SearchX API Key (optional, free tier: 3K/day)
SEARCHX_API_KEY=
