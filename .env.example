# DevAgent Environment Variables
# Copy to .env and fill in your keys. Never commit .env.

# --- Ollama Cloud (optional) ---
# Set both to route all Ollama calls to ollama.com instead of localhost.
# Get your API key at: https://ollama.com/settings/api-keys
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=

# --- Other LLM providers ---
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# GitHub Personal Access Token
GITHUB_PERSONAL_ACCESS_TOKEN=

# Brave Search API Key (optional)
BRAVE_API_KEY=

# SearchX API Key (optional, free tier: 3K/day)
SEARCHX_API_KEY=
